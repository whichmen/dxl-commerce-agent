DXL_DATABASE_PATH=./data/demo.db
DXL_FIXTURE_DIR=./demo/fixtures
DXL_POLICY_PATH=./policies/default.toml
DXL_MAX_HISTORY_TURNS=8
DXL_DEMO_MODE=true
DXL_OPERATOR_KEY=replace-with-a-long-random-local-value

# Optional. The default "rules" planner is deterministic and needs no key.
DXL_PLANNER_MODE=rules
DXL_LLM_BASE_URL=https://example.com/v1
DXL_LLM_MODEL=example-model
DXL_LLM_API_KEY=
