# Decision API
CLAWBOT_HOST=127.0.0.1
CLAWBOT_PORT=18080
CLAWBOT_API_KEY=replace-with-a-random-api-key
CLAWBOT_DECISION_MODE=agent
CLAWBOT_POLICY_FILE=config/policy.yaml
CLAWBOT_DB_PATH=data/clawbot.db
CLAWBOT_HISTORY_DAYS=2

# OpenClaw Agent (configure the model/provider with OpenClaw itself)
CLAWBOT_OPENCLAW_BIN=openclaw
CLAWBOT_OPENCLAW_AGENT_ID=kefu_ops
CLAWBOT_OPENCLAW_TIMEOUT_SEC=120
CLAWBOT_OPENCLAW_LOCAL=1
CLAWBOT_OPENCLAW_ATTACHMENT_MAX_BYTES=12582912

# Tool gateway. Use a separate random value in production.
CLAWBOT_TOOL_BASE_URL=http://127.0.0.1:18080
CLAWBOT_TOOL_API_KEY=replace-with-a-random-tool-key
CLAWBOT_TOOL_TIMEOUT_SEC=8
# OpenClaw tools stay in source; opt in per capability after configuring authorization.
CLAWBOT_ENABLE_ADMIN_QUERY_TOOLS=0
CLAWBOT_ENABLE_REFUND_WRITE_TOOL=0
CLAWBOT_ENABLE_BLACKLIST_WRITE_TOOLS=0
CLAWBOT_ENABLE_OFFLINE_ADMIN_TOOLS=0
CLAWBOT_ENABLE_IMAGE_INSPECT_TOOL=0
CLAWBOT_ENABLE_FILE_READ_TOOL=0
CLAWBOT_ENABLE_SHELL_EXEC_TOOL=0
CLAWBOT_ENABLE_OPENCLAW_BUILTINS=0
# Enabling a tool is not enough: the backend also requires its allowlist.
# File roots use the OS path separator (`:` on Linux). Absolute paths are recommended.
# Example: CLAWBOT_FILE_READ_ROOTS=/srv/kefu/reports:/var/log/kefu
CLAWBOT_FILE_READ_ROOTS=
# Shell rules are best supplied as a quoted JSON array. A rule permits an exact command
# and a simple argument suffix at a whitespace boundary; shell control syntax in a suffix
# is denied. An exact full rule may contain shell syntax when that exact command is needed.
# Example: CLAWBOT_SHELL_ALLOWED_COMMANDS='["git status","journalctl -u kefu-clawbot"]'
# Avoid broad interpreter prefixes such as `sh`, `bash`, `eval`, or `python -c`.
CLAWBOT_SHELL_ALLOWED_COMMANDS=
# DANGER: setting either allowlist to `*` grants unrestricted host file reads or arbitrary
# shell execution. A file root of `/` is likewise unrestricted. Use these only in an
# intentionally isolated disposable environment.
# Legacy master switch for backend compatibility. It does not bypass either allowlist.
CLAWBOT_ADMIN_TOOLS_ENABLED=0

# Merchant ERP / order system adapter
CLAWBOT_KUAIMAI_ERP_HOST=https://erp.example.com
CLAWBOT_KUAIMAI_COMPANY_NAME=
CLAWBOT_KUAIMAI_ACCOUNT=
CLAWBOT_KUAIMAI_PASSWORD=
CLAWBOT_KUAIMAI_COMPANY_ID=
CLAWBOT_KUAIMAI_STORAGE_STATE=data/kuaimai_storage_state.json
CLAWBOT_KUAIMAI_SNAPSHOT_TTL_SEC=300
CLAWBOT_KUAIMAI_LOGIN_HEADLESS=1
CLAWBOT_KUAIMAI_BROWSER_CHANNEL=chrome
CLAWBOT_KUAIMAI_CHROMIUM_PATH=
# Optional merchant-specific product code used by the gift/out-of-stock check.
CLAWBOT_TARGET_OUTER_ID=

# Optional nickname-to-order-identity adapter
CLAWBOT_IDENTITY_BASE_URL=http://127.0.0.1:18082
CLAWBOT_IDENTITY_ORG_ID=org_example
CLAWBOT_IDENTITY_ROOM_NAME=
CLAWBOT_IDENTITY_API_KEY=replace-with-a-random-identity-key
IDENTITY_HOST=127.0.0.1
IDENTITY_PORT=18082
IDENTITY_DB_PATH=data/identity.db
IDENTITY_API_KEY=replace-with-a-random-identity-key

# Optional image understanding
CLAWBOT_IMAGE_INSPECT_ENABLED=0
CLAWBOT_VISION_PROVIDER=qwen_vl
CLAWBOT_QWEN_VL_API_KEY=
CLAWBOT_QWEN_VL_MODEL=qwen3-vl-plus
CLAWBOT_QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLAWBOT_VISION_TIMEOUT_SEC=20

# Worker screenshot OCR: openclaw, hermes, or disabled
CLAWBOT_WORKER_OCR_PROVIDER=openclaw
CLAWBOT_HERMES_OCR_URL=
CLAWBOT_HERMES_OCR_ROUTE=
CLAWBOT_HERMES_OCR_MODEL=
CLAWBOT_HERMES_OCR_API_KEY=
CLAWBOT_HERMES_OCR_TIMEOUT_SEC=60

# Optional Enterprise WeChat bridge
CLAWBOT_WECOM_ENABLED=0
CLAWBOT_WECOM_CORP_ID=
CLAWBOT_WECOM_AGENT_ID=
CLAWBOT_WECOM_APP_SECRET=
CLAWBOT_WECOM_TOKEN=
CLAWBOT_WECOM_AES_KEY=
CLAWBOT_WECOM_APP_NAME=clawbot
CLAWBOT_WECOM_DEFAULT_TOUSER=
CLAWBOT_WECOM_HUB_URL=
CLAWBOT_WECOM_HUB_API_KEY=

# Optional multi-application Enterprise WeChat hub
CLAWBOT_WECOM_HUB_CONFIG=examples/wecom_hub.apps.example.json
CLAWBOT_WECOM_HUB_HOST=127.0.0.1
CLAWBOT_WECOM_HUB_PORT=18081
CLAWBOT_WECOM_HUB_TIMEOUT_SEC=20
CLAWBOT_WECOM_HUB_FALLBACK_TEXT=稍等

# Local files and Android capture
CLAWBOT_MEDIA_ROOT=data/media
CLAWBOT_EXPORT_ROOT=data/exports
CLAWBOT_MEDIA_FETCH_TIMEOUT_SEC=12
CLAWBOT_MEDIA_MAX_BYTES=12582912
CLAWBOT_ADB_CAPTURE_ENABLED=0
CLAWBOT_ADB_BIN=adb
CLAWBOT_ADB_CAPTURE_TIMEOUT_SEC=5

# Safe fallback text used only when the Agent path fails
CLAWBOT_IMAGE_NO_TEXT_REPLY=图片已收到，请补充订单号，我继续处理。
CLAWBOT_FALLBACK_TEXT=系统暂时繁忙，请稍后再试。
