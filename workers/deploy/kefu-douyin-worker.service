[Unit]
Description=DXL Commerce Douyin worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@WORKERS_DIR@
Environment=HOME=@SERVICE_HOME@
EnvironmentFile=-@WORKERS_DIR@/.env.local
ExecStart=@WORKERS_DIR@/scripts/run_douyin_worker.sh
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
