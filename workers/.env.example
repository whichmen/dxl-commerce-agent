# Copy to .env.local, keep it private, and export it before starting a worker.
PYTHON_BIN=python3
TENANT_ID=tenant_example
STORE_ID=douyin_store_example
STORE_NAME=示例抖音店铺
DECISION_URL=http://127.0.0.1:18080
DECISION_KEY=

# Browser profile directories contain platform cookies. Keep them outside exports.
CHROME_USER_DATA_DIR=./chrome_user_data/douyin_example
CHROME_PROFILE_DIR=Default

# Optional private credential file used by the browser keepalive worker.
TAOBAO_ACCOUNTS_CONFIG=./taobao_accounts.conf

# Optional watchdog notification integration.
WATCHDOG_NOTIFY_ENABLED=0
WATCHDOG_NOTIFY_BASE_URL=http://127.0.0.1:18080
WATCHDOG_NOTIFY_API_KEY=
WATCHDOG_NOTIFY_APP_KEY=default
WATCHDOG_NOTIFY_TOUSER=@all
