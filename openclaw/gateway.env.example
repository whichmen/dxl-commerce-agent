# The OpenClaw Gateway process must see these values because the kefu-tools
# plugin runs inside that process. Copy the matching values from the private
# repository-root .env into ~/.openclaw/.env, or run:
#   bash scripts/sync_openclaw_gateway_env.sh

CLAWBOT_TOOL_BASE_URL=http://127.0.0.1:18080
CLAWBOT_TOOL_API_KEY=replace-with-the-same-tool-key-used-by-the-decision-service
CLAWBOT_TOOL_TIMEOUT_SEC=8

# Read-only customer-service tools are registered by default. The following
# capabilities stay in source and are registered only when explicitly enabled.
CLAWBOT_ENABLE_ADMIN_QUERY_TOOLS=0
CLAWBOT_ENABLE_REFUND_WRITE_TOOL=0
CLAWBOT_ENABLE_BLACKLIST_WRITE_TOOLS=0
CLAWBOT_ENABLE_OFFLINE_ADMIN_TOOLS=0
CLAWBOT_ENABLE_IMAGE_INSPECT_TOOL=0
CLAWBOT_ENABLE_FILE_READ_TOOL=0
CLAWBOT_ENABLE_SHELL_EXEC_TOOL=0
CLAWBOT_ENABLE_OPENCLAW_BUILTINS=0

# Optional deployment-specific business marker. Leave empty when unused.
CLAWBOT_TARGET_OUTER_ID=

# These two limits are enforced again by the Python tool backend. They do not
# enable a tool on their own.
CLAWBOT_FILE_READ_ROOTS=
CLAWBOT_SHELL_ALLOWED_COMMANDS=
